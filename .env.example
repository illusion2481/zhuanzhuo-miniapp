# ============================================================
# 专注座（FocusSeat）环境变量模板
# ============================================================
# 使用方式：复制本文件为 .env，按需填入真实值
#   cp .env.example .env
# ⚠️ .env 已被 .gitignore 忽略，绝不可提交到 Git
# ⚠️ 真机 / 云函数 / CI 使用的真实值请通过平台配置面板注入

# ------------------------------------------------------------
# AI 能力（仅云函数 aiRecommend / aiSummary 使用）
# ------------------------------------------------------------
# Coding Plan / Deepseek API Key（必填）
CODING_PLAN_API_KEY=
# Coding Plan 接口基础地址（OpenAI 兼容协议）
CODING_PLAN_BASE_URL=https://chatapi.weixin.qq.com/openai/v1
# 默认模型；可选：Deepseek-v4-flash, GLM-5.2
CODING_PLAN_MODEL=Deepseek-v4-flash

# ------------------------------------------------------------
# 微信云开发
# ------------------------------------------------------------
# 云开发环境 ID（在云开发控制台「环境」页可见）
CLOUD_ENV_ID=cloudbase-d1gehjncwca809f8c

# ------------------------------------------------------------
# 管理员白名单（adminStats 云函数鉴权必填）
# ------------------------------------------------------------
# 多个管理员用英文逗号分隔
# ⚠️ 必须是 sha256(openid).slice(0, 32)，**不要**写入明文 openid
# 生成方法（任选其一）：
#   1. Node.js 一行命令：
#      node -e "console.log(require('crypto').createHash('sha256').update('你的_openid_字符串').digest('hex').slice(0,32))"
#   2. 在线工具：搜索 "sha256 在线加密" → 把结果取前 32 位
#   3. 登录云开发控制台查看 users 集合的 open_id_hash 字段
#
# 示例（**请替换为真实值**）：
#   ADMIN_OPENID_HASHES=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4,99887766554433221100aabbccddeeff
ADMIN_OPENID_HASHES=

# ------------------------------------------------------------
# 演示账号（可选）
# ------------------------------------------------------------
# 比赛体验号：填入你自己的微信号对应 openid（已哈希）
# DEMO_OPENID_HASH=