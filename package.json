{
  "name": "zhuanzhuo-miniapp",
  "version": "0.1.0",
  "description": "专注座（FocusSeat）微信小程序 - 自习座位预约与学习辅助",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint \"miniprogram/**/*.{ts,js}\" \"cloudfunctions/**/*.{ts,js}\" \"scripts/**/*.{ts,js}\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,js,json,scss,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,scss,md}\"",
    "typecheck": "tsc --noEmit -p miniprogram/tsconfig.json",
    "seed:check": "node scripts/data/seedPayload.cjs && node -e \"const p=require('./scripts/data/seedPayload.cjs'); console.log('categories', p.categories.length, 'demoRecords', p.demoRecords.length)\"",
    "fix:tslib": "node scripts/fix-tslib.cjs",
    "trim:tdesign": "node scripts/trim-tdesign.cjs",
    "test:cloud": "node scripts/cloud-logic.test.cjs",
    "test:window": "node scripts/booking-window.parity.cjs",
    "test": "npm run test:cloud && npm run test:window"
  },
  "dependencies": {
    "tdesign-miniprogram": "^1.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "miniprogram-api-typings": "^4.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
